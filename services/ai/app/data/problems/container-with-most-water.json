{
  "id": "container-with-most-water",
  "order": 30,
  "title": "Container With Most Water",
  "difficulty": "Medium",
  "pattern": "Two pointers",
  "statement": "Given `height[i]`, the heights of vertical lines at positions `i`, pick two lines that, with the x-axis, hold the most water. Return that maximum area.",
  "constraints": [
    "2 <= n <= 10^5",
    "0 <= height[i] <= 10^4"
  ],
  "function": {
    "name": "maxArea",
    "params": [
      {
        "name": "height",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "Area = width * min(left, right). Checking all pairs is O(n^2).",
    "Start with the widest pair. Which pointer could possibly lead to a bigger area if you move it?",
    "Two pointers from both ends; always move the shorter line inward, since the taller one can never do better with it."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          8,
          6,
          2,
          5,
          4,
          8,
          3,
          7
        ]
      ],
      "expected": 49,
      "hidden": false,
      "explanation": "Lines at 1 and 8: 7 * 7 = 49."
    },
    {
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": 1,
      "hidden": false,
      "explanation": "Area 1."
    },
    {
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
