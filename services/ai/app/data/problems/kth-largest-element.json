{
  "id": "kth-largest-element",
  "order": 9,
  "title": "Kth Largest Element in an Array",
  "difficulty": "Medium",
  "pattern": "Heap / quickselect",
  "statement": "Given an integer array `nums` and an integer `k`, return the `k`th largest element (in sorted order, not the `k`th distinct element).",
  "constraints": [
    "1 <= k <= nums.length <= 10^5",
    "-10^4 <= nums[i] <= 10^4"
  ],
  "function": {
    "name": "findKthLargest",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      },
      {
        "name": "k",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n log k) with a heap, O(n) average with quickselect",
    "space": "O(k)"
  },
  "hints": [
    "Sorting works in O(n log n). Can you avoid ordering elements you do not care about?",
    "You only need to remember the k largest values seen so far. Which structure lets you evict the smallest of them fast?",
    "Keep a min-heap of size k; push each value and pop when size exceeds k. The heap top is the answer."
  ],
  "tests": [
    {
      "args": [
        [
          3,
          2,
          1,
          5,
          6,
          4
        ],
        2
      ],
      "expected": 5,
      "hidden": false,
      "explanation": "Sorted descending: 6, 5, ..."
    },
    {
      "args": [
        [
          3,
          2,
          3,
          1,
          2,
          4,
          5,
          5,
          6
        ],
        4
      ],
      "expected": 4,
      "hidden": false,
      "explanation": "Duplicates count separately."
    },
    {
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          2,
          1
        ],
        2
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          -1
        ],
        1
      ],
      "expected": -1,
      "hidden": true
    },
    {
      "args": [
        [
          7,
          7,
          7,
          7
        ],
        3
      ],
      "expected": 7,
      "hidden": true
    },
