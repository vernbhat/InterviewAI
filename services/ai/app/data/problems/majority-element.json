{
  "id": "majority-element",
  "order": 15,
  "title": "Majority Element",
  "difficulty": "Easy",
  "pattern": "Boyer-Moore voting",
  "statement": "Given an array `nums` of size `n`, return the element that appears more than `n / 2` times. Such an element always exists.",
  "constraints": [
    "1 <= n <= 5 * 10^4",
    "-10^9 <= nums[i] <= 10^9"
  ],
  "function": {
    "name": "majorityElement",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "A hash map of counts works in O(n) space. Can you use O(1)?",
    "Pair off different elements and cancel them. What survives?",
    "Boyer-Moore: keep a candidate and a count; on count 0 pick the current value, otherwise +1 for a match and -1 for a mismatch."
  ],
  "tests": [
    {
      "args": [
        [
          3,
          2,
          3
        ]
      ],
      "expected": 3,
      "hidden": false,
      "explanation": "3 appears twice out of three."
    },
    {
      "args": [
        [
          2,
          2,
          1,
          1,
          1,
          2,
          2
        ]
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "2 appears four times."
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          5,
          5
        ]
      ],
      "expected": 5,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          -1,
          2
        ]
      ],
      "expected": -1,
      "hidden": true
    },
    {
      "args": [
        [
          7,
          1,
          7,
          2,
          7
        ]
      ],
      "expected": 7,
      "hidden": true
    },
    {
      "args": [
        [
          -5,
          -4,
          -6,
          -8,
          -6,
          -6,
          -6,
          -6
        ]
      ],
      "expected": -6,
      "hidden": true
    },
    {
      "args": [
        [
          6,
          6
        ]
      ],
      "expected": 6,
      "hidden": true
    },
    {
      "args": [
        [
          -5,
          -5,
          -5,
          -5,
          -3,
          2,
          -5,
          -2,
          -5,
          -5,
          -5,
          3,
          10,
          9
        ]
      ],
      "expected": -5,
      "hidden": true
    },
    {
      "args": [
        [
          -8,
          -8,
          -6,
          -8,
          2
        ]
      ],
      "expected": -8,
      "hidden": true
    },
    {
      "args": [
        [
          3,
          -7,
          -7,
          -7
        ]
      ],
      "expected": -7,
      "hidden": true
    },
    {
      "args": [
        [
          -2,
          -6,
          -2,
          -2,
          -2,
          9,
          -4
        ]
      ],
      "expected": -2,
      "hidden": true
    }
  ]
}
