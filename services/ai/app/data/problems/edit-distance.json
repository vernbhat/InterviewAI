{
  "id": "edit-distance",
  "order": 11,
  "title": "Edit Distance",
  "difficulty": "Hard",
  "pattern": "2D dynamic programming",
  "statement": "Given two strings `word1` and `word2`, return the minimum number of single-character insertions, deletions or substitutions needed to turn `word1` into `word2`.",
  "constraints": [
    "0 <= word1.length, word2.length <= 500",
    "Both strings use lowercase English letters"
  ],
  "function": {
    "name": "minDistance",
    "params": [
      {
        "name": "word1",
        "type": "string"
      },
      {
        "name": "word2",
        "type": "string"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(m * n)",
    "space": "O(min(m, n)) with a rolling row"
  },
  "hints": [
    "Think about the last characters of both strings. What are your options if they match? If they do not?",
    "Define dp[i][j] = edits to turn the first i chars of word1 into the first j chars of word2. What are the base cases?",
    "dp[i][j] = dp[i-1][j-1] if chars match, else 1 + min(dp[i-1][j], dp[i][j-1], dp[i-1][j-1]). Base: dp[i][0] = i, dp[0][j] = j."
  ],
  "tests": [
    {
      "args": [
        "horse",
        "ros"
      ],
      "expected": 3,
      "hidden": false,
      "explanation": "horse -> rorse -> rose -> ros."
    },
    {
      "args": [
        "intention",
        "execution"
      ],
      "expected": 5,
      "hidden": false,
      "explanation": "5 operations."
    },
    {
      "args": [
        "",
        ""
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        "",
        "abc"
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        "abc",
        ""
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        "same",
        "same"
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        "a",
        "b"
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        "baabaa",
        ""
      ],
      "expected": 6,
      "hidden": true
    },
    {
      "args": [
        "",
        "abbbaa"
      ],
      "expected": 6,
      "hidden": true
    },
    {
      "args": [
        "bbaaba",
        "ccbbc"
      ],
      "expected": 5,
      "hidden": true
    },
    {
      "args": [
        "aegcdffecg",
        "gcd"
      ],
      "expected": 7,
      "hidden": true
    },
    {
      "args": [
        "abbaa",
        "baabab"
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        "abb",
        "baa"
      ],
      "expected": 3,
      "hidden": true
    }
  ]
}
