{
  "id": "spiral-matrix",
  "order": 48,
  "title": "Spiral Matrix",
  "difficulty": "Medium",
  "pattern": "Matrix simulation",
  "statement": "Given an `m x n` matrix, return all its elements in clockwise spiral order, starting from the top-left.",
  "constraints": [
    "1 <= m, n <= 10",
    "-100 <= matrix[i][j] <= 100"
  ],
  "function": {
    "name": "spiralOrder",
    "params": [
      {
        "name": "matrix",
        "type": "int[][]"
      }
    ],
    "returns": "int[]"
  },
  "complexity": {
    "time": "O(m * n)",
    "space": "O(1) extra"
  },
  "hints": [
    "Think of peeling the matrix one ring at a time.",
    "Keep four boundaries (top, bottom, left, right) and shrink them after each side.",
    "Traverse top row, right column, bottom row (if top < bottom), left column (if left < right); then shrink. Single rows and columns are the trap."
  ],
  "tests": [
    {
      "args": [
        [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ],
          [
            7,
            8,
            9
          ]
        ]
      ],
      "expected": [
        1,
        2,
        3,
        6,
        9,
        8,
        7,
        4,
        5
      ],
      "hidden": false,
      "explanation": "[1,2,3,6,9,8,7,4,5]."
    },
