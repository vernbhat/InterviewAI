{
  "id": "longest-consecutive-sequence",
  "order": 32,
  "title": "Longest Consecutive Sequence",
  "difficulty": "Medium",
  "pattern": "Hash set",
  "statement": "Given an unsorted integer array `nums`, return the length of the longest run of consecutive integers (such as 1, 2, 3, 4) that can be formed from its values. Aim for O(n).",
  "constraints": [
    "0 <= nums.length <= 10^5",
    "-10^9 <= nums[i] <= 10^9"
  ],
  "function": {
    "name": "longestConsecutive",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "hints": [
    "Sorting gives O(n log n). Can a hash set give O(n)?",
    "Only start counting from a number x when x - 1 is not in the set.",
    "Put every value in a set; for each sequence start, walk x+1, x+2, ... and track the longest run."
  ],
  "tests": [
    {
      "args": [
        [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      ],
      "expected": 4,
      "hidden": false,
      "explanation": "1, 2, 3, 4."
    },
    {
      "args": [
        [
          0,
          3,
          7,
          2,
          5,
          8,
          4,
          6,
          0,
          1
        ]
      ],
      "expected": 9,
      "hidden": false,
      "explanation": "0 through 8."
    },
    {
      "args": [
        []
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          5
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          1,
          1,
          1
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          0,
          1
        ]
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        [
          10,
          30,
          20
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          -12,
          -5,
          11,
          4,
          -7,
          13,
          5,
          -12,
          7,
          10,
          1,
          3,
          12
        ]
      ],
      "expected": 4,
      "hidden": true
    },
    {
      "args": [
        [
          -9,
          8,
          -15
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          6,
          9,
          -2,
          12,
          -4,
          1,
          2,
          13,
          -5,
          -6,
          7,
          -13,
          0,
          -7
        ]
      ],
      "expected": 5,
      "hidden": true
    },
    {
      "args": [
        [
          13,
          5,
          -6,
          2
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          13,
          -10,
          6,
          -4,
          -4,
          6,
          10,
          -8,
          14
        ]
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "args": [
        [
          0,
          -13,
          -15,
          -6,
          -13,
          12
        ]
      ],
      "expected": 1,
      "hidden": true
    }
  ]
}
