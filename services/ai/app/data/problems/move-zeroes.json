{
  "id": "move-zeroes",
  "order": 14,
  "title": "Move Zeroes",
  "difficulty": "Easy",
  "pattern": "Two pointers",
  "statement": "Given an integer array `nums`, move all `0`s to the end while keeping the relative order of the non-zero elements. Return the resulting array (do it in place in an interview).",
  "constraints": [
    "1 <= nums.length <= 10^4",
    "-2^31 <= nums[i] <= 2^31 - 1"
  ],
  "function": {
    "name": "moveZeroes",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int[]"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "Can you do it without a second array?",
    "Keep a write pointer for where the next non-zero element should go.",
    "Copy each non-zero to nums[write++], then fill the rest with zeros (or swap as you go)."
  ],
  "tests": [
    {
      "args": [
        [
          0,
          1,
          0,
          3,
          12
        ]
      ],
      "expected": [
        1,
        3,
        12,
        0,
        0
      ],
      "hidden": false,
      "explanation": "Non-zeros keep their order."
    },
    {
      "args": [
        [
          0
        ]
      ],
      "expected": [
        0
      ],
      "hidden": false,
      "explanation": "A single zero stays put."
    },
    {
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ],
      "hidden": true
    },
    {
      "args": [
        [
          0,
          0,
          1
        ]
      ],
      "expected": [
        1,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          1,
          0
        ]
      ],
      "expected": [
        1,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          0,
          0,
          -2
        ]
      ],
      "expected": [
        -1,
