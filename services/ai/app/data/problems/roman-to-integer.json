{
  "id": "roman-to-integer",
  "order": 26,
  "title": "Roman to Integer",
  "difficulty": "Easy",
  "pattern": "Strings",
  "statement": "Convert a valid Roman numeral `s` (symbols I, V, X, L, C, D, M, with subtractive pairs such as IV and CM) to an integer.",
  "constraints": [
    "1 <= s.length <= 15",
    "The value is in [1, 3999]"
  ],
  "function": {
    "name": "romanToInt",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "Most symbols just add. When does a symbol subtract?",
    "A symbol subtracts when a larger symbol comes right after it.",
    "Scan left to right: subtract value[i] if value[i] < value[i+1], else add it."
  ],
  "tests": [
    {
      "args": [
        "III"
      ],
      "expected": 3,
      "hidden": false,
      "explanation": "3."
    },
    {
      "args": [
        "LVIII"
      ],
      "expected": 58,
      "hidden": false,
      "explanation": "50 + 5 + 3 = 58."
    },
    {
      "args": [
        "MCMXCIV"
      ],
      "expected": 1994,
      "hidden": false,
      "explanation": "1000 + 900 + 90 + 4 = 1994."
    },
    {
      "args": [
        "I"
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        "IV"
      ],
      "expected": 4,
      "hidden": true
    },
    {
      "args": [
        "IX"
      ],
      "expected": 9,
      "hidden": true
    },
    {
      "args": [
        "MMMCMXCIX"
      ],
      "expected": 3999,
      "hidden": true
    },
    {
      "args": [
        "XL"
      ],
      "expected": 40,
      "hidden": true
    },
    {
      "args": [
        "MMLXXX"
      ],
      "expected": 2080,
      "hidden": true
    },
    {
      "args": [
        "CV"
      ],
      "expected": 105,
      "hidden": true
    },
    {
      "args": [
        "MCCCVI"
      ],
      "expected": 1306,
      "hidden": true
    },
    {
      "args": [
        "DCXLIII"
      ],
      "expected": 643,
      "hidden": true
    },
    {
      "args": [
        "MCMIII"
      ],
      "expected": 1903,
      "hidden": true
    },
    {
      "args": [
        "MMMDXLV"
      ],
      "expected": 3545,
      "hidden": true
    }
  ]
}
