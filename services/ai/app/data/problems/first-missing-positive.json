{
  "id": "first-missing-positive",
  "order": 60,
  "title": "First Missing Positive",
  "difficulty": "Hard",
  "pattern": "In-place hashing",
  "statement": "Given an unsorted integer array `nums`, return the smallest positive integer that does not appear in it, in O(n) time with O(1) extra space.",
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-2^31 <= nums[i] <= 2^31 - 1"
  ],
  "function": {
    "name": "firstMissingPositive",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "The answer is always in 1..n+1. Why?",
    "Use the array itself as the hash table: value v belongs at index v-1.",
    "Cyclically swap each value in [1, n] into its home slot, then return the first index i with nums[i] != i+1 (or n+1)."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          2,
          0
        ]
      ],
      "expected": 3,
      "hidden": false,
      "explanation": "3."
    },
    {
      "args": [
        [
          3,
          4,
          -1,
          1
        ]
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "2."
    },
    {
      "args": [
        [
          7,
          8,
          9,
          11,
          12
        ]
      ],
      "expected": 1,
      "hidden": false,
      "explanation": "1."
    },
