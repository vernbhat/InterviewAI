{
  "id": "plus-one",
  "order": 20,
  "title": "Plus One",
  "difficulty": "Easy",
  "pattern": "Array, carry",
  "statement": "A non-negative integer is stored as an array of `digits`, most significant first, with no leading zeros. Return the digits of that integer plus one.",
  "constraints": [
    "1 <= digits.length <= 100",
    "0 <= digits[i] <= 9"
  ],
  "function": {
    "name": "plusOne",
    "params": [
      {
        "name": "digits",
        "type": "int[]"
      }
    ],
    "returns": "int[]"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1) (O(n) when every digit is 9)"
  },
  "hints": [
    "The number may be too big for a 64-bit integer. Work on the digits directly.",
    "Where does a carry stop? What happens to trailing 9s?",
    "Scan from the right: turn 9s into 0s; increment the first non-9. If every digit was 9, prepend a 1."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        4
      ],
      "hidden": false,
      "explanation": "123 + 1 = 124."
    },
    {
      "args": [
        [
          9,
          9
        ]
      ],
      "expected": [
        1,
        0,
        0
      ],
      "hidden": false,
      "explanation": "99 + 1 = 100."
    },
    {
      "args": [
        [
          0
        ]
      ],
      "expected": [
        1
      ],
      "hidden": true
    },
    {
      "args": [
        [
          9
        ]
      ],
      "expected": [
        1,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          1,
          9,
          9
        ]
      ],
      "expected": [
        2,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          8,
          9,
          9,
          9
        ]
      ],
      "expected": [
        9,
        0,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          9,
          9,
          9,
          9,
          9
        ]
      ],
      "expected": [
        1,
        0,
        0,
        0,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          9,
          9,
          9
        ]
      ],
      "expected": [
        1,
        0,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          3,
          9,
          4,
          3,
          3,
          9,
          9,
          9,
          9
        ]
      ],
      "expected": [
        3,
        9,
        4,
        3,
        4,
        0,
        0,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          8,
          9,
          9,
          9,
          9,
          9,
          1,
          6
        ]
      ],
      "expected": [
        8,
        9,
        9,
        9,
        9,
        9,
        1,
        7
      ],
      "hidden": true
    },
    {
      "args": [
        [
          9,
          9,
          9,
          9
        ]
      ],
      "expected": [
        1,
        0,
        0,
        0,
        0
      ],
      "hidden": true
    },
    {
      "args": [
        [
          2,
