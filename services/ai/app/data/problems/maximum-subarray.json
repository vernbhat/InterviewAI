{
  "id": "maximum-subarray",
  "order": 28,
  "title": "Maximum Subarray",
  "difficulty": "Medium",
  "pattern": "Kadane's algorithm",
  "statement": "Given an integer array `nums`, return the largest sum of any non-empty contiguous subarray.",
  "constraints": [
    "1 <= nums.length <= 10^5",
    "-10^4 <= nums[i] <= 10^4"
  ],
  "function": {
    "name": "maxSubArray",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "Checking every subarray is O(n^2). What is the best subarray that ends at index i?",
    "best_ending_at(i) = max(nums[i], best_ending_at(i-1) + nums[i]).",
    "Kadane: track the current running sum (reset when it would be worse than starting fresh) and the best seen. Watch all-negative input."
  ],
  "tests": [
    {
      "args": [
        [
          -2,
          1,
          -3,
          4,
          -1,
          2,
          1,
          -5,
          4
        ]
      ],
      "expected": 6,
      "hidden": false,
      "explanation": "[4,-1,2,1] sums to 6."
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1,
      "hidden": false,
      "explanation": "Single element."
    },
    {
      "args": [
        [
          5,
          4,
          -1,
          7,
          8
        ]
      ],
      "expected": 23,
      "hidden": false,
      "explanation": "The whole array, 23."
    },
    {
      "args": [
        [
          -3
        ]
      ],
      "expected": -3,
      "hidden": true
    },
    {
      "args": [
        [
          -2,
          -1
        ]
      ],
      "expected": -1,
      "hidden": true
    },
    {
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
