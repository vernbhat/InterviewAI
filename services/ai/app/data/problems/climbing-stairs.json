        "type": "int"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "How can you reach step n? From which earlier steps?",
    "ways(n) = ways(n - 1) + ways(n - 2). Does that look familiar?",
    "Iterate with two variables holding the last two values (Fibonacci), avoiding exponential recursion."
  ],
