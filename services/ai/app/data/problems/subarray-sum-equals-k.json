{
  "id": "subarray-sum-equals-k",
  "order": 45,
  "title": "Subarray Sum Equals K",
  "difficulty": "Medium",
  "pattern": "Prefix sums + hash map",
  "statement": "Given an integer array `nums` and an integer `k`, return the number of contiguous non-empty subarrays whose sum equals `k`.",
  "constraints": [
    "1 <= nums.length <= 2 * 10^4",
    "-1000 <= nums[i] <= 1000",
    "-10^7 <= k <= 10^7"
  ],
  "function": {
    "name": "subarraySum",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      },
      {
        "name": "k",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "hints": [
    "Sliding windows fail with negative numbers. Think in terms of prefix sums.",
    "sum(i..j) = prefix[j] - prefix[i-1]. For each j, how many earlier prefixes equal prefix[j] - k?",
    "Keep a hash map of prefix-sum counts, starting with {0: 1}; add count[prefix - k] at each step."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          1,
          1
        ],
        2
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "Two subarrays [1,1]."
    },
    {
      "args": [
        [
          1,
          2,
          3
        ],
        3
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "[1,2] and [3]."
    },
    {
      "args": [
        [
          0
        ],
        0
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          0,
          0,
          0
        ],
        0
      ],
      "expected": 6,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          -1,
          1
        ],
        0
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          1
        ],
        2
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          1,
          3,
          2,
          2,
          0,
          3
        ],
        -2
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          -3,
          3,
          -1,
          2,
          -3,
          3,
          0,
          0,
          -1,
          2,
          2,
          0,
          -1,
          1,
          3
        ],
        -1
      ],
      "expected": 9,
      "hidden": true
    },
    {
      "args": [
        [
          2
        ],
        5
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          -1,
          -2,
          4,
          -2,
          2,
          3,
          -1,
          0,
          -1,
          3,
          4,
          2,
          -3,
          2,
          -1,
          -1
        ],
        4
      ],
      "expected": 13,
      "hidden": true
    },
    {
      "args": [
        [
          3,
          -1
        ],
        -2
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          -2,
          -2,
          4,
          4,
          -1,
          4,
          0,
          4,
          -1,
          3,
          0,
          0
        ],
        7
      ],
      "expected": 7,
      "hidden": true
    }
  ]
}
