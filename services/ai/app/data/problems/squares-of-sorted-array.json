{
  "id": "squares-of-sorted-array",
  "order": 27,
  "title": "Squares of a Sorted Array",
  "difficulty": "Easy",
  "pattern": "Two pointers",
  "statement": "Given an integer array `nums` sorted in non-decreasing order, return the squares of each number, also sorted in non-decreasing order.",
  "constraints": [
    "1 <= nums.length <= 10^4",
    "-10^4 <= nums[i] <= 10^4"
  ],
  "function": {
    "name": "sortedSquares",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int[]"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(n) for the output"
  },
  "hints": [
    "Squaring then sorting is O(n log n). Where are the largest squares?",
    "The largest square is at one of the two ends.",
    "Two pointers from both ends; place the larger square at the back of the output and move that pointer inward."
  ],
