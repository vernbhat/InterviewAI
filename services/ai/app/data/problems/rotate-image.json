{
  "id": "rotate-image",
  "order": 49,
  "title": "Rotate Image",
  "difficulty": "Medium",
  "pattern": "Matrix",
  "statement": "Given an `n x n` matrix, rotate it 90 degrees clockwise and return it. In an interview, explain how to do it in place.",
  "constraints": [
    "1 <= n <= 20",
    "-1000 <= matrix[i][j] <= 1000"
  ],
  "function": {
    "name": "rotate",
    "params": [
      {
        "name": "matrix",
        "type": "int[][]"
      }
    ],
    "returns": "int[][]"
  },
  "complexity": {
    "time": "O(n^2)",
    "space": "O(1) in place"
  },
  "hints": [
    "Where does the element at (i, j) end up after a clockwise rotation?",
    "It moves to (j, n-1-i). Could two simpler in-place operations combine to do this?",
    "Transpose the matrix (swap [i][j] with [j][i]), then reverse each row."
  ],
  "tests": [
