{
  "id": "counting-bits",
  "order": 24,
  "title": "Counting Bits",
  "difficulty": "Easy",
  "pattern": "DP on bits",
  "statement": "Given an integer `n`, return an array `ans` of length `n + 1` where `ans[i]` is the number of `1` bits in the binary form of `i`.",
  "constraints": [
    "0 <= n <= 10^5"
  ],
  "function": {
    "name": "countBits",
    "params": [
      {
        "name": "n",
        "type": "int"
      }
    ],
    "returns": "int[]"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1) extra"
  },
  "hints": [
    "Counting the bits of each number separately is O(n log n). Can earlier answers help?",
    "How does i relate to i >> 1 in binary?",
    "ans[i] = ans[i >> 1] + (i & 1)."
  ],
