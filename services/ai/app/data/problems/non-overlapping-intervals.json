{
  "id": "non-overlapping-intervals",
  "order": 53,
  "title": "Non-overlapping Intervals",
  "difficulty": "Medium",
  "pattern": "Greedy, intervals",
  "statement": "Given `intervals`, return the minimum number to remove so that the rest do not overlap. Intervals that only touch (such as `[1,2]` and `[2,3]`) do not overlap.",
  "constraints": [
    "1 <= intervals.length <= 10^5",
    "-5 * 10^4 <= start < end <= 5 * 10^4"
  ],
  "function": {
    "name": "eraseOverlapIntervals",
    "params": [
      {
        "name": "intervals",
        "type": "int[][]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n log n)",
    "space": "O(1) extra"
  },
  "hints": [
    "Equivalently: keep as many non-overlapping intervals as possible.",
    "Which interval should you keep first to leave the most room for the others?",
    "Sort by end; keep an interval if its start >= last kept end, otherwise count it as removed."
  ],
  "tests": [
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            2,
            3
          ],
          [
            3,
            4
          ],
          [
            1,
            3
          ]
        ]
      ],
      "expected": 1,
      "hidden": false,
      "explanation": "Remove [1,3]."
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            1,
            2
          ],
          [
            1,
            2
          ]
        ]
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "Keep one."
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": 0,
      "hidden": false,
      "explanation": "Touching is fine."
    },
    {
      "args": [
        [
          [
            0,
            1
          ]
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          [
            1,
            100
          ],
          [
            11,
            22
          ],
          [
            1,
            11
          ],
          [
            2,
            12
          ]
        ]
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "args": [
        [
          [
            -5,
            -1
          ],
          [
            -3,
            0
          ]
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          [
            -5,
            -3
          ],
          [
            -9,
            -6
          ],
          [
            17,
            19
          ]
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          [
            0,
            1
          ],
          [
            11,
            13
          ]
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          [
            11,
            13
          ],
          [
            5,
            10
          ]
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          [
            9,
            15
          ],
          [
            0,
            2
          ],
          [
            2,
            7
          ],
          [
            18,
            19
          ]
        ]
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        [
          [
            2,
            8
          ],
          [
            16,
            17
          ],
          [
            -1,
            2
          ],
          [
            7,
            11
          ],
          [
            20,
            25
          ],
          [
            4,
            9
          ],
          [
            4,
            10
          ]
        ]
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        [
          [
            -10,
            -5
          ],
          [
            14,
            16
          ],
          [
            4,
            8
          ],
          [
            14,
            20
          ]
        ]
      ],
      "expected": 1,
      "hidden": true
    }
  ]
}
