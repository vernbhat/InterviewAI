{
  "id": "n-queens-ii",
  "order": 58,
  "title": "N-Queens II",
  "difficulty": "Hard",
  "pattern": "Backtracking",
  "statement": "Return the number of ways to place `n` queens on an `n x n` chessboard so that no two queens attack each other.",
  "constraints": [
    "1 <= n <= 9"
  ],
  "function": {
    "name": "totalNQueens",
    "params": [
      {
        "name": "n",
        "type": "int"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n!)",
    "space": "O(n)"
  },
  "hints": [
    "Each row holds exactly one queen, so place them row by row.",
    "A placement is attacked through its column or one of its two diagonals. How can you check that in O(1)?",
    "Backtrack with sets (or bitmasks) for columns, r - c diagonals and r + c diagonals."
  ],
