{
  "id": "house-robber",
  "order": 35,
  "title": "House Robber",
  "difficulty": "Medium",
  "pattern": "1D dynamic programming",
  "statement": "`nums[i]` is the money in house `i` along a street. You cannot rob two adjacent houses. Return the maximum amount you can rob.",
  "constraints": [
    "1 <= nums.length <= 100",
    "0 <= nums[i] <= 400"
  ],
  "function": {
    "name": "rob",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1)"
  },
  "hints": [
    "Greedy (always take the biggest) fails. Think about house i: rob it or skip it.",
    "best(i) = max(best(i-1), best(i-2) + nums[i]).",
    "Iterate keeping two values: the best with house i robbed and the best with it skipped."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          2,
          3,
          1
        ]
      ],
      "expected": 4,
      "hidden": false,
      "explanation": "Rob houses 0 and 2: 4."
    },
    {
      "args": [
        [
          2,
          7,
          9,
          3,
          1
        ]
      ],
      "expected": 12,
      "hidden": false,
