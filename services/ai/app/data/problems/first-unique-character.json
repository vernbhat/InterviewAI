{
  "id": "first-unique-character",
  "order": 22,
  "title": "First Unique Character in a String",
  "difficulty": "Easy",
  "pattern": "Counting",
  "statement": "Given a string `s`, return the index of the first character that appears exactly once, or `-1` if there is none.",
  "constraints": [
    "1 <= s.length <= 10^5",
    "Lowercase English letters"
  ],
  "function": {
    "name": "firstUniqChar",
    "params": [
      {
        "name": "s",
        "type": "string"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(n)",
    "space": "O(1) (26 counters)"
  },
  "hints": [
    "You need to know each character's total count before deciding.",
    "Two passes: count everything first, then scan in order.",
    "Count with an array of 26; on the second pass return the first index whose count is 1."
  ],
  "tests": [
    {
      "args": [
        "leetcode"
      ],
      "expected": 0,
      "hidden": false,
      "explanation": "'l' at index 0."
    },
    {
      "args": [
        "loveleetcode"
      ],
      "expected": 2,
      "hidden": false,
      "explanation": "'v' at index 2."
    },
    {
      "args": [
        "aabb"
      ],
      "expected": -1,
      "hidden": false,
      "explanation": "No unique character."
    },
    {
      "args": [
        "a"
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        "aa"
      ],
      "expected": -1,
      "hidden": true
    },
    {
      "args": [
        "abcabd"
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "args": [
        "zzy"
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "args": [
        "aghabafda"
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        "cffhc"
      ],
      "expected": 3,
      "hidden": true
    },
    {
      "args": [
        "af"
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        "bbeabcgb"
      ],
      "expected": 2,
      "hidden": true
    },
    {
      "args": [
        "eb"
      ],
      "expected": 0,
      "hidden": true
    },
    {
      "args": [
        "f"
      ],
      "expected": 0,
      "hidden": true
    }
  ]
}
