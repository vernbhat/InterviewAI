{
  "id": "find-minimum-in-rotated-sorted-array",
  "order": 34,
  "title": "Find Minimum in Rotated Sorted Array",
  "difficulty": "Medium",
  "pattern": "Binary search",
  "statement": "Given a sorted array of distinct integers that has been rotated an unknown number of times, return its minimum element in O(log n).",
  "constraints": [
    "1 <= nums.length <= 5000",
    "Values are distinct"
  ],
  "function": {
    "name": "findMin",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "int"
  },
  "complexity": {
    "time": "O(log n)",
    "space": "O(1)"
  },
  "hints": [
    "Compare nums[mid] with nums[hi]. What does it tell you about where the drop is?",
    "If nums[mid] > nums[hi], the minimum is strictly to the right of mid.",
    "lo = mid + 1 when nums[mid] > nums[hi], else hi = mid; loop while lo < hi and return nums[lo]."
  ],
  "tests": [
    {
      "args": [
        [
          3,
          4,
          5,
          1,
          2
        ]
      ],
      "expected": 1,
      "hidden": false,
      "explanation": "Minimum 1."
    },
    {
      "args": [
        [
          4,
          5,
          6,
          7,
          0,
          1,
          2
        ]
      ],
      "expected": 0,
      "hidden": false,
      "explanation": "Minimum 0."
    },
    {
      "args": [
        [
          11,
          13,
          15,
          17
        ]
      ],
      "expected": 11,
      "hidden": false,
      "explanation": "Not rotated."
    },
    {
      "args": [
        [
          1
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          2,
          1
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": 1,
      "hidden": true
    },
    {
      "args": [
