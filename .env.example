# --- LLM (optional; without a key the interviewer runs an offline script) ---
# Any OpenAI-compatible endpoint works. Default is Groq's free tier.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo
# Local alternative: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5-coder:7b  GROQ_API_KEY=ollama

# --- Code execution ---
# local  = subprocess with rlimits (development only, NOT a sandbox)
# judge0 = Judge0 CE (self-hosted Docker or RapidAPI)
EXECUTOR=local
JUDGE0_URL=http://localhost:2358
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
RUN_TIMEOUT_S=5
RUN_MEMORY_MB=512

# --- Storage / server ---
INTERVIEWAI_DB=interviewai.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: use an Anthropic Messages API backend instead of an OpenAI-compatible one.
# The anthropic SDK reads ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL itself. Voice input still needs a Groq key.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
