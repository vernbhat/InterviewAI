{
  "name": "interview-ai",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source, self-hostable AI mock interviewer for DSA coding rounds (C++ and Python).",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cd services/ai && python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "cd services/ai && python -m pytest -q"
  },
  "workspaces": [
    "apps/web"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
